HARUKA_NAME=Haruka
HARUKA_USERNAME=haruka
HARUKA_DATA_DIR=./data
HARUKA_DB_PATH=./data/haruka.sqlite3
HARUKA_SNAPSHOT_DIR=./data/snapshots
HARUKA_SCAN_INTERVAL_SECONDS=60
HARUKA_STYLE_REFRESH_INTERVAL_SECONDS=21600
HARUKA_SNAPSHOT_INTERVAL_SECONDS=300
HARUKA_INITIATIVE_ENABLED=false
HARUKA_INITIATIVE_INTERVAL_SECONDS=900
HARUKA_INITIATIVE_PROBABILITY=0.03
HARUKA_ALLOWED_CHAT_IDS=
HARUKA_MAX_SCAN_DIALOGS=50

TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_BOT_TOKEN=
TELEGRAM_SESSION=./data/haruka.session
TELEGRAM_BOT_API_BASE=https://api.telegram.org

AI_PROVIDER=google_gemma
GEMMA_API_KEY=your_provider_key
GEMMA_API_BASE=https://your-openai-compatible-provider.example/v1
GEMMA_MODEL=google/gemma-3-27b-it
AI_TEMPERATURE=0.82
AI_MAX_TOKENS=500

HARUKA_DRY_RUN=false
HARUKA_LOG_LEVEL=INFO
