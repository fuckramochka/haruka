HARUKA_NAME=Харука
HARUKA_USERNAME=haruka
HARUKA_DATA_DIR=./data
HARUKA_DB_PATH=./data/haruka.sqlite3
HARUKA_SNAPSHOT_DIR=./data/snapshots
HARUKA_SCAN_INTERVAL_SECONDS=10
HARUKA_INITIATIVE_INTERVAL_SECONDS=300
HARUKA_INITIATIVE_PROBABILITY=0.08

# Telethon requires Telegram API credentials from https://my.telegram.org.
TELEGRAM_API_ID=36957317
TELEGRAM_API_HASH=d4668cbc3d5a5ff9e9a3eccd1768c2d5

# Optional. If omitted, Telethon starts an interactive user session.
# User sessions are more realistic and can read normal chats the account belongs to.
TELEGRAM_BOT_TOKEN=
TELEGRAM_SESSION=./data/haruka.session

# Provider abstraction. Default assumes an OpenAI-compatible chat completion API.
AI_PROVIDER=google_gemma
GEMMA_API_KEY=AIzaSyBilucCGGLkNIlqArTSt9OPyBB6pR-SOTc
GEMMA_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
GEMMA_MODEL=google/gemma-4-31b-it
AI_TEMPERATURE=0.82
AI_MAX_TOKENS=500

# Safety/runtime controls.
HARUKA_DRY_RUN=false
HARUKA_LOG_LEVEL=INFO
